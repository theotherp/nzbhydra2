{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "intellij_search_file": "deny",
    "intellij_search_text": "deny",
    "intellij_read_file": "deny",
    "intellij_list_directory_tree": "deny",
    "intellij_apply_patch": "deny",
    "intellij_search_regex": "deny"
  },
  "agent": {
    "migration-orchestrator": {
      "description": "Coordinates frontend migration FM tasks",
      "model": "openai/gpt-5.6-terra",
      "variant": "low",
      "permission": {
        "edit": {
          "*": "deny",
          "docs/frontend-migration/STATUS.md": "allow",
          "docs/frontend-migration/tasks/FM-*.md": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git add*": "allow",
          "git commit*": "allow"
        },
        "task": {
          "*": "deny",
          "migration-implementer": "allow",
          "migration-reviewer": "allow",
          "migration-fixer": "allow",
          "migration-task-designer": "allow",
          "migration-adr-proposer": "allow"
        }
      }
    }
  },
    "mcp": {
        "mnemosyne": {
            "type": "local",
            "command": [
                "/home/sist/.local/bin/mnemosyne",
                "mcp"
            ],
            "environment": {
                "MNEMOSYNE_DATA_DIR": "/home/sist/projects/nzbhydra2/.mnemosyne"
            },
            "enabled": true
        }
    }
}
