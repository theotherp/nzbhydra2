# GitHub App credentials (required). Create the App once in GitHub settings,
# install it on the repos it should watch, generate a private key for it.
BOT_GITHUB_APP_ID=123456
BOT_GITHUB_APP_PRIVATE_KEY_FILE=./secrets/app.pem
# Optional: skip installation discovery if you already know it (Settings ->
# Installed GitHub Apps -> the app -> URL contains .../installations/<id>).
#BOT_GITHUB_APP_INSTALLATION_ID=12345678

# Anthropic API key (required). The SDK reads this automatically.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if the API key isn't scoped to a workspace (the API then says so).
#ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Repos to watch, comma-separated, "owner/repo".
BOT_REPOS=theotherp/nzbhydra2,theotherp/apitests

# Model to use for triage.
BOT_MODEL=claude-sonnet-5

# Poll interval in seconds.
BOT_POLL_INTERVAL=300

# Where to persist bot state between runs. Only for non-Docker runs (default
# ./state/state.json); the Docker image sets /data/state.json itself, which
# docker-compose.yml maps to ./state. Don't set it when using Docker.
#BOT_STATE_FILE=./state/state.json

# Label added to issues that are missing required information.
BOT_NEEDS_INFO_LABEL=needs-info

# Comma-separated logins of maintainers: their own issues are skipped, and a
# comment from any of them on a tracked issue ends bot tracking of it.
BOT_IGNORE_USERS=theotherp

# Comma-separated labels that make a new issue skipped entirely (e.g. feature
# requests that already carry the "enhancement" label).
BOT_SKIP_LABELS=enhancement

# Issues created before this ISO timestamp are never processed. Only applies
# on a true first run, i.e. when the state file doesn't track any repo yet: it
# is then used for every repo in BOT_REPOS. A repo added to BOT_REPOS later,
# while the state file already tracks others, gets max(BOT_START_AT, now)
# instead, so its backlog isn't processed either - it just isn't tied to a
# timestamp that's normally already in the past by the time that happens.
# Leave unset to use the moment each repo is first polled, so the backlog of
# pre-existing issues is never processed.
#BOT_START_AT=2026-01-01T00:00:00Z

# If true, only logs what would be posted/labelled; makes no GitHub writes and
# never writes the state file (state is kept in memory only).
BOT_DRY_RUN=false

# Python logging level.
BOT_LOG_LEVEL=INFO
