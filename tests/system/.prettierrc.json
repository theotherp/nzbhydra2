{
  "singleQuote": false,
  "tabWidth": 4,
  "trailingComma": "all",
  "bracketSpacing": false,
  "overrides": [
    {
      "files": ["*.json", "*.json5"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.html"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
